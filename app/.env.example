# Copy this file to src-tauri/.env (not committed).
# Register a separate OAuth app on each GitHub environment.
# api_base_url is optional: github.com defaults to https://api.github.com,
# *.ghe.com defaults to https://api.<tenant>.ghe.com, and GitHub Enterprise
# Server defaults to <web_base_url>/api/v3.
GITHUB_ENVIRONMENTS='[{"id":"github.com","name":"GitHub.com","web_base_url":"https://github.com","api_base_url":"https://api.github.com","client_id":"","client_secret":""},{"id":"msft.ghe.com","name":"Microsoft GitHub","web_base_url":"https://msft.ghe.com","api_base_url":"https://api.msft.ghe.com","client_id":"","client_secret":""}]'

# Legacy single-environment configuration remains supported when
# GITHUB_ENVIRONMENTS is not set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
